{
  "rules": {
    "votes": {
      "$voteId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['answer', 'updatedAt']) && newData.child('answer').isString() && (newData.child('answer').val() == 'yes' || newData.child('answer').val() == 'no' || newData.child('answer').val() == 'unknown')"
      }
    }
  }
}
